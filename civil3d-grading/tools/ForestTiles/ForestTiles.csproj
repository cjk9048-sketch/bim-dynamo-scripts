<Project Sdk="Microsoft.NET.Sdk">
  <!-- ★[v115 · JACK 1105 임상도] 임상도 SHP → 2 km 타일 변환기(개발 PC에서 dotnet run -c Release · 배포 EXE 아님) ·
       Core 프로젝트는 참조하지 않고 Forest 파일 넷만 링크(Core가 고쳐지는 중에도 빌드됨) · 하네스는 같은 파일을 Core로 시험 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NetTopologySuite" Version="2.5.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\DH.Grading.Core\Forest\ShpDbfReader.cs" Link="Forest\ShpDbfReader.cs" />
    <Compile Include="..\..\src\DH.Grading.Core\Forest\ForestConvert.cs" Link="Forest\ForestConvert.cs" />
    <Compile Include="..\..\src\DH.Grading.Core\Forest\ForestTileFormat.cs" Link="Forest\ForestTileFormat.cs" />
    <Compile Include="..\..\src\DH.Grading.Core\Forest\ForestCodes.cs" Link="Forest\ForestCodes.cs" />
  </ItemGroup>
</Project>
