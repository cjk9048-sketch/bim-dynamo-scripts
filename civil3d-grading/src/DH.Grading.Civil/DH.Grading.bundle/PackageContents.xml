<?xml version="1.0" encoding="utf-8"?>
<!--
  Civil3D 자동 로드 매니페스트(소스 템플릿 — 배포본과 동일하게 유지할 것).
  이 .bundle 폴더 전체를 아래 위치에 복사하면 Civil3D 시작 시 자동 로드된다:
    %APPDATA%\Autodesk\ApplicationPlugins\DH.Grading.bundle
  Contents 폴더에 빌드 산출물(DH.Grading.Civil.dll, DH.Grading.Core.dll)과 뷰 LISP를 넣을 것.
-->
<ApplicationPackage SchemaVersion="1.0"
                    AppVersion="93.8.0"
                    ProductType="Application"
                    Name="DH 정지(절성토)"
                    Description="계단식 정지 비탈면 자동 생성 (distance-field)">
  <CompanyDetails Name="도화엔지니어링 상하수도부" />
  <Components Description="DH Grading">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.0" SeriesMax="R25.1" />
    <ComponentEntry AppName="DH.Grading"
                    ModuleName="./Contents/DH.Grading.Civil.dll"
                    LoadOnAutoCADStartup="True"
                    PerDocument="False">
      <Commands GroupName="DH_GRADING">
        <Command Global="DHGRADE" Local="DHGRADE" />
        <Command Global="DHWALL" Local="DHWALL" />
        <Command Global="DHSLOPE" Local="DHSLOPE" />
        <Command Global="DHNORI" Local="DHNORI" />
        <Command Global="DHINFRA" Local="DHINFRA" />
        <Command Global="DHRESET" Local="DHRESET" />
        <Command Global="DHMAP" Local="DHMAP" />
        <Command Global="DHMAPOFF" Local="DHMAPOFF" />
        <Command Global="DHCONTOUR" Local="DHCONTOUR" />
        <Command Global="DHPARCEL" Local="DHPARCEL" />
        <Command Global="DHGRADESET" Local="DHGRADESET" />
        <Command Global="DHXSEC" Local="DHXSEC" />
        <Command Global="DHSLOPELINE" Local="DHSLOPELINE" />
        <Command Global="DHCS" Local="DHCS" />
        <!-- ★[JACK 0915 배포판] 코드의 [CommandMethod]를 전부 싣는다 —
             자동 로드라 없어도 돌긴 하지만, 매니페스트가 실제와 어긋나 있으면
             도면 쪽에서 "이 명령이 있는지" 확인할 길이 남지 않는다. -->
        <Command Global="DHBANDCHK" Local="DHBANDCHK" />
        <Command Global="DHBANDINFO" Local="DHBANDINFO" />
        <Command Global="DHCONTOURBOX" Local="DHCONTOURBOX" />
        <Command Global="DHCONTOURWEB" Local="DHCONTOURWEB" />
        <Command Global="DHCROP" Local="DHCROP" />
        <Command Global="DHEXCAV" Local="DHEXCAV" />
        <Command Global="DHEXCAVPANEL" Local="DHEXCAVPANEL" />
        <Command Global="DHEXCAVSLOPE" Local="DHEXCAVSLOPE" />
        <Command Global="DHEXCAVWALL" Local="DHEXCAVWALL" />
        <Command Global="DHEXCAVWALLCLEAR" Local="DHEXCAVWALLCLEAR" />
        <Command Global="DHGNDREBUILD" Local="DHGNDREBUILD" />
        <Command Global="DHGRADEPANEL" Local="DHGRADEPANEL" />
        <Command Global="DHMAPPICK" Local="DHMAPPICK" />
        <Command Global="DHMISCSET" Local="DHMISCSET" />
        <Command Global="DHNGII" Local="DHNGII" />
        <Command Global="DHPARCELOFF" Local="DHPARCELOFF" />
        <Command Global="DHPICKCLEAR" Local="DHPICKCLEAR" />
        <Command Global="DHPICKSTATUS" Local="DHPICKSTATUS" />
        <Command Global="DHPROFILE" Local="DHPROFILE" />
        <Command Global="DHSAMPLE" Local="DHSAMPLE" />
        <Command Global="DHSECTION" Local="DHSECTION" />
        <Command Global="DHSHEET" Local="DHSHEET" />
        <Command Global="DHSHEETSET" Local="DHSHEETSET" />
        <Command Global="DHSTATION" Local="DHSTATION" />
        <Command Global="DHSTATIONDEL" Local="DHSTATIONDEL" />
        <Command Global="DHSTATIONFB" Local="DHSTATIONFB" />
        <Command Global="DHSTRATA" Local="DHSTRATA" />
        <Command Global="DHSTRATAPICK" Local="DHSTRATAPICK" />
        <Command Global="DHTICKCHK" Local="DHTICKCHK" />
        <Command Global="DHTICKDIAG" Local="DHTICKDIAG" />
        <Command Global="DHTICKSET" Local="DHTICKSET" />
        <Command Global="DHVIEW" Local="DHVIEW" />
        <Command Global="DHVIEWALL" Local="DHVIEWALL" />
        <Command Global="DHVIEWE" Local="DHVIEWE" />
        <Command Global="DHVIEWG" Local="DHVIEWG" />
        <Command Global="DHVIEWP" Local="DHVIEWP" />
        <Command Global="DHXVIEW" Local="DHXVIEW" />
      </Commands>
    </ComponentEntry>
    <!-- [JACK 0731] 3D 뷰 전환 단축 LISP(v1~v4·vv1~vv3) — 애드인과 함께 항상 자동 로드(설치 안 돼 있으면 이걸로 대체).
         LISP는 문서별로 c: 명령을 정의하므로 PerDocument=True. 경로 공백 함정 회피 위해 파일명은 공백 없이. -->
    <ComponentEntry AppName="DH.ViewShortcuts"
                    ModuleName="./Contents/3D_VIEW_LOCATION.LSP"
                    LoadOnAutoCADStartup="True"
                    PerDocument="True" />
  </Components>
</ApplicationPackage>
