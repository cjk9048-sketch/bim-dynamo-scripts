<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>DH.Grading.Civil</AssemblyName>
    <RootNamespace>DH.Grading.Civil</RootNamespace>
    <!-- Civil3D는 .NET 어셈블리 직접 빌드를 막지 않도록 CS1701 등 경고 완화 -->
    <NoWarn>$(NoWarn);CS1701;CS1702</NoWarn>
    <!-- NuGet 의존성(NetTopologySuite 등)을 출력(bin)에 복사 → 플러그인과 함께 배포되도록 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    Civil3D 2026 / AutoCAD 2026 관리형 DLL을 빌드타임만 참조한다(런타임 미복사: Private=false).
    실행은 설치된 Civil3D 2026이 자기 DLL을 로드한다.
    설치 경로가 다르면 아래 AcadDir 한 줄만 바꾸면 된다.
  -->
  <PropertyGroup>
    <!-- AutoCAD 기본 DLL은 설치 루트, Civil3D DLL은 그 아래 C3D 폴더에 있다. -->
    <AcadDir Condition="'$(AcadDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2026\</AcadDir>
    <CivilDir Condition="'$(CivilDir)' == ''">$(AcadDir)C3D\</CivilDir>
    <AcaDir Condition="'$(AcaDir)' == ''">$(AcadDir)ACA\</AcaDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="acmgd">
      <HintPath>$(AcadDir)acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadDir)acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AcadDir)accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(AcadDir)AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- AEC 기반 클래스(Entity 등) — Civil3D 타입이 상속하므로 필수 -->
    <Reference Include="AecBaseMgd">
      <HintPath>$(AcaDir)AecBaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Civil3D 도메인 API (C3D 하위 폴더) -->
    <Reference Include="AeccDbMgd">
      <HintPath>$(CivilDir)AeccDbMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- AutoCAD Map 좌표계 API(도면 좌표계 읽기/지정 — MAPCSASSIGN 상당). Map 하위 폴더. -->
    <Reference Include="AcMapCoordsysCoreMgd">
      <HintPath>$(AcadDir)Map\AcMapCoordsysCoreMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DH.Grading.Core\DH.Grading.Core.csproj" />
  </ItemGroup>

  <!-- [JACK 0731] 사내 PostGIS(등고선·지적도) 직결용. AutoCAD와의 어셈블리 충돌을 피하려고
       로깅/기타 부수 패키지는 끌어오지 않는 최소 구성으로 쓴다(Npgsql 단독). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2478.35" />
    <PackageReference Include="Npgsql" Version="8.0.3" />
  </ItemGroup>

  <!-- 리본 버튼 아이콘(PNG)을 DLL에 포함 -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" />
    <!-- ★[JACK 0807] 회사 표준 종단도 템플릿(DHT.dwt)을 DLL에 심는다 —
         사용자가 dwt 파일을 따로 챙기거나 경로를 맞출 필요가 없게 하려는 것. -->
    <EmbeddedResource Include="Resources\DHT.dwt" />
  </ItemGroup>

  <!--
    ★WebView2 네이티브 로더를 <b>출력 폴더 바로 밑</b>에도 둔다.
    NuGet은 runtimes/win-x64/native/ 아래에 넣는데, AutoCAD가 NETLOAD로 우리를 불러올 때는
    deps.json 규칙이 안 도므로 그 경로를 못 찾는다 — 옆에 있어야 찾는다.
  -->
  <Target Name="CopyWebView2Loader" AfterTargets="Build">
    <Copy SourceFiles="$(NuGetPackageRoot)microsoft.web.webview2\1.0.2478.35\runtimes\win-x64\native\WebView2Loader.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

  <!--
    ★★★[JACK 0903 "닫았어 설치해줘" — 그런데 깔린 것은 어제 DLL이었다]
    <b>빌드 결과를 번들 폴더에 곧바로 넣는다.</b>

    <b>왜.</b> 설치 스크립트(배포/설치.ps1)는 <b>번들 폴더</b>를 통째로 복사한다.
    그런데 빌드는 bin\에만 결과를 놓았고 둘을 잇는 단계가 없었다 —
    그래서 "빌드 성공 · 설치 완료"라고 적히면서도 <b>실제로는 어제 DLL이 다시 깔렸다</b>.
    md5도 맞았다(둘 다 옛것이라 맞은 것이다). 사람이 매번 손으로 옮기는 한 언제든 또 난다.
    → 잇는 단계를 여기 못 박는다. 이제 빌드하면 번들이 곧 최신이다.
  -->
  <!--
    ★[검토 0903 — 치명] <b>이름을 하나씩 적었더니 4개를 빠뜨렸다.</b>
      bin에는 10개인데 적어 둔 것은 6개 — NetTopologySuite·Npgsql·Microsoft.Extensions 둘이 빠졌다.
      NetTopologySuite는 교선 계산(RawTriangleIntersectionFinder)이 쓰므로 <b>없으면 정지가 죽는다</b>.
      지금 안 터진 이유는 설치본에 <b>예전에 손으로 넣은 것이 남아 있어서</b>일 뿐이다 —
      새 컴퓨터·배포 zip·번들을 지우고 다시 깔면 그 자리에서 터진다.
    → <b>목록을 손으로 적지 않는다.</b> OutDir에 나온 것을 통째로 옮긴다.
      참조 DLL(Autodesk 등)은 Private=false라 애초에 OutDir에 오지 않으므로 섞일 것이 없다.

    ★[검토 0903] ContinueOnError를 뺐다 — 복사가 실패해도 "빌드 성공"이 되어
      <b>이 단계가 없애려던 바로 그 사고</b>(옛 DLL을 최신인 줄 알고 설치)가 되살아난다.
    ★[검토 0903] Release에서만 돌게 했다 — 없으면 Debug 빌드 한 번에 배포 번들이
      조용히 Debug 판으로 바뀐다(로그에도 안 남는다).
    ★[검토 0903] WebView2Loader가 OutDir에 놓인 <b>뒤에</b> 돌아야 하므로 그 타깃 뒤로 못 박았다
      (종전에는 선언 순서에만 기대고 있었다).
  -->
  <Target Name="CopyToBundle" AfterTargets="CopyWebView2Loader" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_BundlePayload Include="$(OutDir)*.dll" />
      <_BundlePayload Include="$(OutDir)DH.Grading.*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_BundlePayload)"
          DestinationFolder="$(MSBuildProjectDirectory)\DH.Grading.bundle\Contents"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="번들 갱신 — 구성 $(Configuration)" />
  </Target>

</Project>
