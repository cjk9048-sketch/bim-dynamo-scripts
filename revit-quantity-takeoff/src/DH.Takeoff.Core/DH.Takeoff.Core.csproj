<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DH.Takeoff.Core</AssemblyName>
    <RootNamespace>DH.Takeoff.Core</RootNamespace>
  </PropertyGroup>

  <!-- 다각형 연산(합치기·빼기·겹친 자리)은 Clipper2 1.5.4 의 소스를 Formwork\Clipper2 에 넣어 쓴다(internal).
       DLL 을 따로 싣지 않으므로 배포 파일은 그대로 둘(Revit · Core)이고, 다른 애드인의 Clipper2 와 부딪히지 않는다. -->

  <!-- 같은 어셈블리의 내부 기하 도구를 시험에서 직접 본다 -->
  <ItemGroup>
    <InternalsVisibleTo Include="DH.Takeoff.Core.Tests" />
  </ItemGroup>

</Project>
